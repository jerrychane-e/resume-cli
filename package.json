{
  "name": "resume-cli",
  "version": "1.0.0",
  "description": "AI 简历解析命令行工具 — 从 PDF 简历中提取结构化信息并与 JD 进行匹配评分，支持浏览器可视化展示",
  "type": "module",
  "bin": {
    "resume-cli": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "serve": "node src/index.js serve",
    "dev": "node src/index.js serve --port 3000",
    "install:all": "npm install && cd web && npm install"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "pdf-parse": "^1.1.1",
    "openai": "^4.0.0",
    "https-proxy-agent": "^7.0.0",
    "zod": "^3.22.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "multer": "^2.0.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
